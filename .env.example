# GEMINI_API_KEY: Required for Gemini AI API calls.
# Users configure this with their Google Gemini API key.
GEMINI_API_KEY=""

# APP_URL & PORT: Application host URL and server port.
APP_URL="http://localhost:3000"
PORT=3000

# Firebase Client Configuration
# Obtain these from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIREBASE_OAUTH_CLIENT_ID=""

# Push Notifications Configuration
# VITE_FIREBASE_VAPID_KEY: The public VAPID key from Firebase Console -> Project Settings -> Cloud Messaging -> Web Push certificates.
VITE_FIREBASE_VAPID_KEY=""

# FIREBASE_SERVICE_ACCOUNT_BASE64: The base64 encoded string of your firebase-admin service account JSON.
# Generates via Firebase Console -> Settings -> Service Accounts -> "Generate new private key".
# Then encode using: `base64 -w 0 <path-to-json-file>`
FIREBASE_SERVICE_ACCOUNT_BASE64=""

# OPENWEATHER_API_KEY: Required for localized weather data (proxied securely on backend).
# Get one for free at https://openweathermap.org/api
OPENWEATHER_API_KEY=""
VITE_OPENWEATHER_API_KEY=""

# Razorpay Payment Keys & Webhook Secret
# Get keys from https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID=""
VITE_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Webhook secret configured in Razorpay Dashboard -> Webhooks -> Add New Webhook
RAZORPAY_WEBHOOK_SECRET=""
